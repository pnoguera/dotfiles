#!/usr/bin/env bash

[ -z "$1" ] && echo "Usage: goupdate VERSION|latest" && exit 2

if [ $1 == "latest" ]; then
    VERSION=$(curl -qs "https://go.dev/dl/?mode=json"|jq -r '.[0].version')
else
    VERSION="go$1"
fi

# Install the specified version
go install golang.org/dl/${VERSION}@latest
${VERSION} download

# Update the symlink for the active Go version
[ -f ~/go/bin/go ] && rm ~/go/bin/go
ln -s ~/go/bin/${VERSION} ~/go/bin/go

# Optionally clean up old versions
echo "Cleaning up old Go versions..."
for go_version_dir in ~/sdk/go*; do
    if [[ "$go_version_dir" != *"${VERSION}"* ]]; then
        echo "Removing $go_version_dir"
        rm -rf "$go_version_dir"
    fi
done
