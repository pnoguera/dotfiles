{
    "include": "~/.config/waybar/modules",
    "layer": "bottom",
    //"mode": "dock",
    "position": "top",
    "height": 20,
    //"passthrough": false,
    //"ipc":true,
    "spacing": 1, // Gaps between modules (4px)
    "reload_style_on_change": true,
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "warp-on-scroll": false,
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "🖂",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false,
        },
        "modules": [
            "temperature",
            "cpu",
            "memory"
        ]
    },
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "custom/ping",
        "mpris"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
//        "cpu",
//        "memory",
//        "temperature",
        "group/hardware",
        "power-profiles-daemon",
        "backlight",
        "keyboard-state",
        "sway/language",
        "battery",
        "battery#bat2",
        "tray",
        "clock",
        "custom/power"
    ],
}

